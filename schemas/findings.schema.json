{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.schema.json",
  "title": "findings.json - argument of the submit action",
  "description": "Structure only. Values (type, ids, currency, amount) are not restricted here: a structurally valid finding with an unknown type, a padded currency or a non-existent id is a false positive, not an invalid submission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "findings"],
  "properties": {
    "episode_id": {"type": "string"},
    "findings": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_ids", "explanation"],
      "properties": {
        "type": {"type": "string"},
        "affected_ids": {"type": "array", "items": {"type": "string"}},
        "claimed_amount_minor": {"type": "integer"},
        "currency": {"type": "string"},
        "evidence_ids": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
        "explanation": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
